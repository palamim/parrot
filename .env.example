ANTHROPIC_API_KEY=sk-ant-...

# Optional: default folder to scan when no path is passed on the command line.
PROJECTS_ROOT=/path/to/your/projects/folder

# Optional: path to the style guide file parrot reads before drafting and
# rewrites whenever you give feedback. Defaults to ./parrot.style.md — you
# don't write this file yourself; parrot maintains it. Overridable per run
# with --style <path>.
PARROT_STYLE_FILE=./parrot.style.md
