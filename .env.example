ANTHROPIC_API_KEY=sk-ant-...

# Optional: default folder to scan when no path is passed on the command line.
PROJECTS_ROOT=/path/to/your/projects/folder

# Optional: path to a style guide file describing the voice and the kinds of
# claims/topics to favor when drafting tweets. Defaults to ./parrot.style.md
# (see parrot.style.example.md for the format). Overridable per run with
# --style <path>.
PARROT_STYLE_FILE=./parrot.style.md
